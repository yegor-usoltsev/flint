# Settings for `bun run dev` on the host against the compose services; copy to .env.
# Commented variables show their defaults.

# Local stack only.
# Host name the browser uses; compose also builds Gitea's ROOT_URL and the OAuth redirect from it.
PUBLIC_HOST=localhost
# Host address compose publishes the app and Gitea on; Postgres and Silo stay on 127.0.0.1.
PUBLIC_HOST_BIND=127.0.0.1
# Gitea site admin the gitea:* scripts sign in as.
GITEA_ADMIN_USER=alice
GITEA_ADMIN_PASSWORD=password

# Flint's public origin.
APP_URL=http://${PUBLIC_HOST}:4700
# PostgreSQL 18 with pgvector.
DATABASE_URL=postgres://flint:flint@localhost:4702/flint

# Gitea as Flint's server and as browsers reach it.
GITEA_URL=http://${PUBLIC_HOST}:4701
GITEA_PUBLIC_URL=http://${PUBLIC_HOST}:4701
# Gitea OAuth2 application; compose writes both to .env.local.
# GITEA_CLIENT_ID=
# GITEA_CLIENT_SECRET=
# Secret of the Gitea system webhook.
GITEA_WEBHOOK_SECRET=flint-webhook-secret

# S3-compatible storage for attachments.
S3_ENDPOINT=http://localhost:4703
S3_BUCKET=flint
S3_ACCESS_KEY_ID=flint
S3_SECRET_ACCESS_KEY=flint-silo-secret
# S3_REGION=auto

# Largest attachment in bytes (25 MB, at least 1 MB); Bun caps request bodies at 128 MB.
# MAX_UPLOAD_BYTES=26214400
# Days before deleted issues and pages are purged.
# TRASH_RETENTION_DAYS=30
# Cron schedules of the trash purge and of the sweep of orphaned uploads, in the server's local
# time zone (UTC in the image unless TZ is set).
# TRASH_PURGE_CRON=0 0 * * *
# STORAGE_SWEEP_CRON=1 0 * * 0

# Semantic search through any OpenAI-compatible /embeddings API with a 1024-dimension model;
# without a key search is full-text only. Run bun run embeddings:backfill after changing the model.
EMBEDDING_API_KEY=
# EMBEDDING_API_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b

# Listening port of the built server.
# PORT=3000

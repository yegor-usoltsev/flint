{
  "name": "@yegor-usoltsev/flint",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted issue tracker and Markdown wiki for teams that run Gitea",
  "homepage": "https://github.com/yegor-usoltsev/flint#readme",
  "bugs": "https://github.com/yegor-usoltsev/flint/issues",
  "license": "MIT",
  "author": "Yegor Usoltsev (https://github.com/yegor-usoltsev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yegor-usoltsev/flint.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build && bun build scripts/migrate.ts scripts/embeddings-backfill.ts scripts/storage-sweep.ts --target bun --outdir dist",
    "dev": "bun run migrate && vite dev | pino-pretty",
    "embeddings:backfill": "bun scripts/embeddings-backfill.ts",
    "gitea:bootstrap": "bun scripts/gitea-bootstrap.ts",
    "gitea:external-tracker": "bun scripts/gitea-external-tracker.ts",
    "lint": "tsc && ultracite check",
    "lint:fix": "tsc && ultracite fix",
    "migrate": "bun scripts/migrate.ts",
    "demo": "bun scripts/dev/demo.ts",
    "cli:build": "bun build cli/flint.ts --target node --minify --define \"process.env.FLINT_COMMIT='$(git rev-parse --short HEAD 2>/dev/null || echo dev)'\" --metafile=cli/dist/meta.json --outfile cli/dist/flint.js && bun scripts/licenses.ts cli/dist/meta.json cli/dist/licenses.md",
    "cli:smoke": "bun scripts/dev/cli-smoke.ts",
    "flint": "bun cli/flint.ts",
    "storage:sweep": "bun scripts/storage-sweep.ts",
    "start": "bun .output/server/index.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/abstract": "0.5.1",
    "@dnd-kit/collision": "0.5.1",
    "@dnd-kit/dom": "0.5.1",
    "@dnd-kit/helpers": "0.5.1",
    "@dnd-kit/react": "0.5.1",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bubble-menu": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-code-block-lowlight": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-paragraph": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/suggestion": "3.32.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "fractional-indexing": "4.0.0",
    "highlight.js": "11.12.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.61.0",
    "mermaid": "12.2.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@rolldown/plugin-babel": "0.2.4",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "commander": "15.0.0",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "4.2.2",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "oxlint-tsgolint": "7.0.2005",
    "pino-pretty": "13.2.0",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ultracite": "8.0.2",
    "vite": "8.3.5"
  }
}
